# QuietPay API (Person A). Copy to apps/api/.env; never commit it.
PORT=4000
DATABASE_PATH=./quietpay.db
WHITECHAIN_SEPOLIA_RPC_URL=https://rpc.testnet.whitechain.io
# Optional: defaults to the address in packages/shared (deployments.ts)
QUIETPAY_ADDRESS=

# YOUR relayer key (an operator on QuietPay; pays all gas). Each teammate's API uses its own.
RELAYER_PK=0x
# 32-byte hex, encrypts merchant signer keys at rest:  openssl rand -hex 32
ENCRYPTION_KEY=
# Signs dashboard/portal sessions:  openssl rand -hex 24
JWT_SECRET=
PUBLIC_WEB_URL=http://localhost:3001

# Seed script (pnpm --filter @quietpay/api seed)
# Wallet that receives Swag Counter payments and signs in to the dashboard (default: relayer address)
SEED_PAYOUT_ADDRESS=
SEED_WEBHOOK_URL=http://localhost:3000/api/webhooks/quietpay

# Demo helpers (A9 / A11)
DEMO_PERIOD_OVERRIDE=
DEMO_MODE=false
DEMO_TREASURY_PK=
