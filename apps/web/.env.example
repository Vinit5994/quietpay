# QuietPay API. Mock API (tools/mock-api) until the real API is ready, then http://localhost:4000
NEXT_PUBLIC_QUIETPAY_API_URL=http://localhost:4010
# "privy" = email/Google login with a Privy embedded wallet on Whitechain Sepolia.
# "dev" = browser demo wallet (no account needed; also the fallback if Privy is unavailable).
NEXT_PUBLIC_WALLET_MODE=dev
# Privy App ID (public client id) from dashboard.privy.io. Allowed origins must include this app's URL.
NEXT_PUBLIC_PRIVY_APP_ID=
# Shows testnet-only helpers such as /demo/fund
NEXT_PUBLIC_DEMO_MODE=true
# Wallets that can open /admin (QuietPay team), comma-separated
NEXT_PUBLIC_ADMIN_ADDRESSES=
# Demo merchant store linked from the landing page
NEXT_PUBLIC_DEMO_STORE_URL=http://localhost:3000
