# QuietPay API. Mock API (tools/mock-api) until the real API is ready, then http://localhost:4000
NEXT_PUBLIC_QUIETPAY_API_URL=http://localhost:4010
# "dev" = browser demo wallet (no Privy). "privy" = Privy embedded wallets (task B4)
NEXT_PUBLIC_WALLET_MODE=dev
NEXT_PUBLIC_PRIVY_APP_ID=
# Shows testnet-only helpers such as /demo/fund
NEXT_PUBLIC_DEMO_MODE=true
