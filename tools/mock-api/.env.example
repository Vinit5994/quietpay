MOCK_PORT=4010
# Where the mock sends signed webhooks for the seeded Swag Counter merchant
MOCK_WEBHOOK_URL=http://localhost:3000/api/webhooks/quietpay
# Used to build checkout/receipt URLs
MOCK_WEB_URL=http://localhost:3001
# Fake confirmation delay for payments and refunds
MOCK_CONFIRM_MS=2000
# Starting USDT balance for any wallet the mock hasn't seen
MOCK_DEFAULT_BALANCE=100.00
# true = reject bad signatures with invalid_signature; false = accept and log a warning
MOCK_STRICT_SIGNATURES=false
