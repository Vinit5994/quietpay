# Person A: chain scripts (deploy, verify, first payment).
# Copy to .env.deploy (git-ignored), fill in, then load into your shell:
#   set -a; source .env.deploy; set +a
# Never commit real keys. Testnet wallets only.

# --- network
WHITECHAIN_SEPOLIA_RPC_URL=https://rpc.testnet.whitechain.io
USDT=0xcedfB56113143d55b2358b8CFbB0dEB5Ad2f55a7

# --- deploy (contracts/script/Deploy.s.sol)
# Deployer: pays for the deploy (~4.5M gas) and is the constructor owner. Needs WBT from the faucet.
DEPLOYER_PK=0x
# Final owner (optional). Leave empty to keep the deployer as owner.
OWNER=
# Your API relayer address (the address of RELAYER_PK below).
RELAYER_A=0x
# Person B's relayer address: RELAYER_B_ADDRESS from .env.relayer-b. Optional; can be added later with setOperator.
RELAYER_B=0x

# --- first payment (scripts/first-payment.ts)
# Your relayer: operator on QuietPay, pays gas for registerMerchant + pay. Needs WBT.
# Must be YOUR key, not B's (each API needs its own relayer, see WORK_SPLIT §8).
RELAYER_PK=0x
# Demo treasury: the payer. Needs >= 1.00 test USDT, no WBT needed.
DEMO_TREASURY_PK=0x
# Optional: where the merchant receives funds (default: relayer address).
MERCHANT_PAYOUT=
# Optional: amount to pay (default 1.00).
AMOUNT=
# QuietPay address is read from packages/shared after `pnpm abi:export`; set it here only to override.
QUIETPAY_ADDRESS=
